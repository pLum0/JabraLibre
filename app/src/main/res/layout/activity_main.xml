<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Modus: –" android:textSize="16sp" android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/devices"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnDiag" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Diagnose" />

        <Button android:id="@+id/btnShare" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Log exportieren" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnAnc" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="ANC"
            android:background="@drawable/mode_button_bg" />
        <Button android:id="@+id/btnHt" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="HearThrough"
            android:background="@drawable/mode_button_bg" />
        <Button android:id="@+id/btnOff" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Off"
            android:background="@drawable/mode_button_bg" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp"
            android:text="JabraLibre bereit.\n" />
    </ScrollView>
</LinearLayout>
