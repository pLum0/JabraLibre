<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows replaces this view's padding with the window insets,
     so the content padding has to live on an inner container or it is lost. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- ── header ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/devicePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="150dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── connection status ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:text="@string/state_idle" />

            <Button
                android:id="@+id/btnAction"
                style="@style/DiagButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_green"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="@string/action_reconnect" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <!-- ── mode cards ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/cardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardAnc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/mode_card_anc">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mode_anc"
                    android:tint="@color/mode_icon_anc"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_anc"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_title"
                        android:duplicateParentState="true" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/checkAnc"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFFFF"
                    android:visibility="invisible"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/mode_card_ht">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mode_ht"
                    android:tint="@color/mode_icon_ht"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_ht"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_title"
                        android:duplicateParentState="true" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/checkHt"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFFFF"
                    android:visibility="invisible"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/mode_card_off">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mode_off"
                    android:tint="@color/mode_icon_off"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_off"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_title"
                        android:duplicateParentState="true" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/checkOff"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFFFF"
                    android:visibility="invisible"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>


        <!-- ── battery (topic 1202) ───────────────────────────── -->
        <LinearLayout
            android:id="@+id/batteryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_flat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bat_left"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/batLValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/bat_unknown" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bar_track">

                    <View
                        android:id="@+id/batLFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bar_fill" />

                    <View
                        android:id="@+id/batLRest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_flat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bat_right"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/batRValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/bat_unknown" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bar_track">

                    <View
                        android:id="@+id/batRFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bar_fill" />

                    <View
                        android:id="@+id/batRRest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_flat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bat_case"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/batCaseValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:text="@string/bat_unknown" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bar_track">

                    <View
                        android:id="@+id/batCaseFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bar_fill" />

                    <View
                        android:id="@+id/batCaseRest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/spacerBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── diagnostics drawer ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/diagHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/diagChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron"
                android:tint="@color/text_secondary"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/diag_title"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diagPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_hint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:alpha="0.8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnReadMode"
                        style="@style/DiagButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_refresh" />

                    <Button
                        android:id="@+id/btnScanChannels"
                        style="@style/DiagButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_scan_channels" />

                    <Button
                        android:id="@+id/btnScanTopics"
                        style="@style/DiagButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_scan_topics" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExport"
                        style="@style/DiagButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_export" />

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/DiagButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_clear" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/log_bg"
                android:padding="10dp">

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
